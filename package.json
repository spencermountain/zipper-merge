{
  "name": "zipper-merge",
  "version": "0.0.1",
  "description": "CLI tool to help with merge conflicts",
  "scripts": {
    "build": "node ./scripts/version.js && rollup -c",
    "start": "node builds/index.js",
    "dev": "pnpm --dir dummy dev",
    "watch": "pnpm --dir dummy watch",
    "test": "npm run build && tape \"tests/*.test.js\" | tap-dancer",
    "prepack": "npm run build",
    "test:package": "npm test",
    "dummy:simple": "node scripts/examples/index.js simple",
    "dummy:multi": "node scripts/examples/index.js multi",
    "dummy:many": "node scripts/examples/index.js many",
    "dummy:multi-step": "node scripts/examples/index.js multi-step",
    "dummy:clean": "node scripts/examples/index.js clean"
  },
  "type": "module",
  "main": "./builds/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/spencermountain/zipper-merge.git"
  },
  "files": [
    "builds/index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-link": "^5.0.0",
    "ink-scroll-list": "^0.5.0",
    "react": "^19.2.0",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "rollup": "^4.63.5",
    "tap-dancer": "^0.4.3",
    "tape": "^5.10.2",
    "tsx": "^4.23.15"
  },
  "license": "MIT",
  "exports": {
    ".": "./builds/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "zipper-merge": "./builds/index.js"
  }
}
